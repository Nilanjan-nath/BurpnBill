# BurpnBill production settings. On the VM this becomes /opt/burpnbill/.env
# (mode 600, owned by the burpnbill user). Never commit the filled-in copy.

# --- Server (read by the API at start-up) ---------------------------------

# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Same page. Backend only; never put this in web/.env.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase Dashboard > Project Settings > Database > Connection string,
# "Session pooler". The free plan allows about 5 connections.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Path to Supabase's CA certificate (Database > SSL Configuration > Download),
# e.g. /opt/burpnbill/prod-ca-2021.crt. Leave empty for now: the connection is
# encrypted but not verified. Set it, then turn on "Enforce SSL" in Supabase.
DATABASE_CA_CERT=

PORT=4000

# Optional. The API believes client addresses only from Caddy on this machine.
# Leave unset. RATE_LIMIT=off turns the per-client limits off (testing only).
# TRUST_PROXY=loopback
# RATE_LIMIT=off

# Who invoices to cafes are from (printed on each invoice, copied onto it when it is
# recorded). Optional; the name defaults to BurpnBill. Set before the first payment.
# BILLING_SELLER_NAME=
# BILLING_SELLER_ADDRESS=
# BILLING_SELLER_PHONE=
# BILLING_SELLER_EMAIL=
# BILLING_SELLER_TAX_ID=

# MUST be the public address. Printed QR codes encode it: a wrong value means
# a sheet of dead links. Also the only origin CORS allows.
APP_BASE_URL=https://www.burpnbill.com

# --- Web build (baked into the bundle at build time) ----------------------
# These two go in /opt/burpnbill/web/.env, NOT this file. Public values only.
#   VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#   VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY   (Project Settings > API, "anon public")
# Do not set VITE_API_URL: the API is on the same origin.
