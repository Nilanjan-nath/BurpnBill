# Public Supabase values only — used by the staff dashboard (/staff) to sign
# in. Same project as the server's SUPABASE_URL/SUPABASE_ANON_KEY in the
# repo root .env; copy those two values here. The service-role key never
# goes in a web/.env file — it must never reach the browser build.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
