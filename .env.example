# Supabase — from Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY          # frontend only
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY # backend only — NEVER ship to the client

# Postgres connection — Dashboard > Project Settings > Database > Connection string.
# Use the Session pooler string. Used by scripts/db.sh (psql) and by the API server.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Optional but recommended: path to Supabase's CA certificate
# (Dashboard > Project Settings > Database > SSL Configuration > Download certificate).
# Without it the API's database connection is encrypted but not verified.
DATABASE_CA_CERT=

# Backend
PORT=4000
APP_BASE_URL=http://localhost:5173   # used to build QR code URLs: {APP_BASE_URL}/t/{qr_token}
